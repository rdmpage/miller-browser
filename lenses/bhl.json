{
  "prefixes": {
    "bhlv": "https://www.biodiversitylibrary.org/vocab/",
    "bibo": "http://purl.org/ontology/bibo/",
    "dcterms": "http://purl.org/dc/terms/",
    "dwc": "http://rs.tdwg.org/dwc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/"
  },
  "hiddenTypes": [
    "bhlv:PagePosition"
  ],
  "hiddenPredicates": [
    "bhlv:part"
  ],
  "types": {
    "bibo:Page": {
      "title": [
        "{bhlv:pagePrefix} {bhlv:pageNumber}",
        "Seq. {bhlv:sequenceOrder}"
      ],
      "sort": {
        "property": "bhlv:sequenceOrder",
        "numeric": true
      },
      "image": "https://www.biodiversitylibrary.org/pagethumb/{local}"
    },
    "bibo:Book": {
      "title": [
        "dcterms:identifier"
      ],
      "summary": [
        "dcterms:date",
        "bhlv:institution"
      ],
      "sort": {
        "property": "dcterms:date"
      }
    },
    "bhlv:Title": {
      "summary": [
        "dcterms:issued",
        "dcterms:subject"
      ]
    },
    "bibo:Article": {
      "summary": [
        "bhlv:containerTitle",
        "bibo:volume",
        "bhlv:pageRange"
      ]
    }
  },
  "edges": {
    "in dcterms:isPartOf bibo:Page": {
      "label": "Pages"
    },
    "in dcterms:isPartOf bibo:Book": {
      "label": "Items"
    },
    "in dcterms:isPartOf bibo:Article": {
      "label": "Articles"
    },
    "out dcterms:isPartOf": {
      "label": "Part of"
    },
    "out bhlv:hasPage": {
      "label": "Pages"
    },
    "in bhlv:hasPage": {
      "label": "In article"
    },
    "out dcterms:creator": {
      "label": "Creators"
    },
    "in dcterms:creator": {
      "label": "Titles"
    },
    "in dcterms:creator bibo:Article": {
      "label": "Articles"
    }
  }
}
